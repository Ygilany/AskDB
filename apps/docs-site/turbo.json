{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The docs `test` script runs its own `astro build` (with ASTRO_BASE=/), so unlike the
    // root `test` task it does not also depend on this package's `build`.
    "test": {
      "dependsOn": ["^build"],
      // `test:errors` checks the API reference against these files, which live outside this package.
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/core/src/errors.ts",
        "$TURBO_ROOT$/packages/client/src/errors.ts"
      ]
    }
  }
}
