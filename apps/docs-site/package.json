{
  "name": "@askdb/docs-site",
  "version": "0.0.1-rc.24",
  "private": true,
  "description": "Static documentation site for AskDB.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "dev": "astro dev --host 127.0.0.1 --port 4310",
    "lint": "astro check",
    "test": "pnpm run test:errors && pnpm run test:exports && pnpm run test:diagrams && pnpm run test:markdown && pnpm run test:examples && pnpm run test:prose && ASTRO_BASE=/ pnpm run build && pnpm run test:links",
    "test:diagrams": "node --test ./plugins/remark-diagram.test.mjs ./plugins/remark-mermaid.test.mjs ./plugins/remark-link-cards.test.mjs",
    "test:examples": "node --test ./scripts/check-chart-example.test.mjs",
    "test:errors": "node --test ./scripts/check-error-reference.test.mjs && node ./scripts/check-error-reference.mjs",
    "test:exports": "node --test ./scripts/check-export-coverage.test.mjs && node ./scripts/check-export-coverage.mjs",
    "test:links": "node --test ./scripts/check-link-targets.test.mjs && node ./scripts/check-base-links.mjs / && node ./scripts/check-link-targets.mjs / && node ./scripts/check-markdown-twins.mjs /",
    "test:prose": "node --test ./scripts/check-prose.test.mjs && node ./scripts/check-prose.mjs",
    "test:markdown": "node --test ./src/utils/markdown-twin.test.mjs ./src/utils/html-to-markdown.test.mjs ./src/utils/llms-txt.test.mjs ./scripts/check-markdown-twins.test.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/starlight": "^0.43.1",
    "@emnapi/runtime": "^1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/hast": "^3.0.5",
    "astro": "^7.4.7",
    "hast-util-select": "^6.0.4",
    "hast-util-to-text": "^4.0.3",
    "pele": "1.13.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  }
}
