{
  "name": "@askdb/docs-site",
  "version": "0.0.1-beta.5",
  "private": true,
  "description": "Static documentation site for AskDB.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "dev": "astro dev --host 127.0.0.1 --port 4310",
    "lint": "astro check",
    "test": "ASTRO_BASE=/ pnpm run build && pnpm run test:links",
    "test:links": "node ./scripts/check-base-links.mjs /"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "starlight-llms-txt": "^0.11.0"
  }
}
