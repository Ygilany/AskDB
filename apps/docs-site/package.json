{
  "name": "@askdb/docs-site",
  "version": "0.0.1-beta.6",
  "private": true,
  "description": "Static documentation site for AskDB.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "dev": "astro dev --host 127.0.0.1 --port 4310",
    "lint": "astro check",
    "test": "ASTRO_BASE=/ pnpm run build && pnpm run test:links",
    "test:links": "node ./scripts/check-base-links.mjs /"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.4",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0"
  }
}
