{
  "name": "@askdb/docs-site",
  "version": "0.0.1-beta.18",
  "private": true,
  "description": "Static documentation site for AskDB.",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "dev": "astro dev --host 127.0.0.1 --port 4310",
    "lint": "astro check",
    "test": "pnpm run test:errors && pnpm run test:exports && pnpm run test:diagrams && ASTRO_BASE=/ pnpm run build && pnpm run test:links",
    "test:diagrams": "node --test ./plugins/remark-mermaid.test.mjs",
    "test:errors": "node --test ./scripts/check-error-reference.test.mjs && node ./scripts/check-error-reference.mjs",
    "test:exports": "node --test ./scripts/check-export-coverage.test.mjs && node ./scripts/check-export-coverage.mjs",
    "test:links": "node --test ./scripts/check-link-targets.test.mjs && node ./scripts/check-base-links.mjs / && node ./scripts/check-link-targets.mjs /"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.8",
    "@emnapi/runtime": "^1.11.3",
    "astro": "^7.4.7",
    "pele": "1.10.0",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0"
  }
}
