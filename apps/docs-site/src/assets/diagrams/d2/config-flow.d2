# @askdb/config: how a setting reaches a run. env() reads the environment only while the
# config file loads; bootstrapAskDbEnv() checks the result and installs it as the process's
# snapshot; each surface reads the snapshot with getAskDbRuntimeConfig().
# Source of truth: packages/config/src/bootstrap.ts (dotenv, then the config file, then
# setAskDbRuntime), env.ts, runtime-config.ts; callers in apps/cli/src/project-config.ts,
# apps/studio/src/bin.ts, apps/http-api/src/server.ts:283, packages/client/src/client.ts:87.
# Vertical, with the surfaces in a 2x2 grid, so the text stays full size on a phone.
direction: down

env: ".env and your shell"
file: "askdb.config.ts"
snapshot: "runtime snapshot\n(one per process)"
surfaces: "" {
  grid-columns: 2
  cli: "askdb CLI"
  studio: "Studio"
  http: "askdb-http"
  client: "createAskDb()"
}

env -> file: "env(\"NAME\")\nwhile the file loads"
file -> snapshot: "bootstrapAskDbEnv():\nchecked, defaults filled in"
snapshot -> surfaces: "getAskDbRuntimeConfig(),\nin each run"
