# The SQL checks: which run on the model's SQL, in order, and how their findings become one outcome.
# Source of truth: packages/core/src/ask.ts (enforceGuardrails call) and sql/guardrails.ts (the
# decision: read-only always deny; tenant by enforcement; sensitive by sensitiveGuardrailMode).
# Vertical, with the outcomes in a row, so the text stays full size on a phone.
direction: down

sql: "the model's SQL\nand its sql-unbound block"
readonly: "read-only check\nbuilt-in id or DialectSpec only"
tenant: "tenant check\nwith a tenant policy"
sensitive: "sensitive check\nwith sensitive marks"
verdict: "verdict\nevery finding"
outcomes: "" {
  grid-columns: 3
  allow: "allow"
  warn: "warn:\nreturned, reported"
  deny: "deny:\nthrows"
}

sql -> readonly
readonly -> tenant
tenant -> sensitive
sensitive -> verdict
verdict -> outcomes
