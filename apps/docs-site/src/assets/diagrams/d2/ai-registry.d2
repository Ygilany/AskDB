# @askdb/ai: how a registry turns settings into a model. A host passes a config section
# (askdb.config) or an env map (no config file); the registry picks the adapter registered for
# the provider name or alias, which resolves an AiConfig and builds the AI SDK model ask() takes.
# Source of truth: packages/ai/src/registry.ts (createAiRegistry, the *FromSection and *FromEnv
# methods) and provider.ts (AiProviderAdapter).
# Vertical, so the text stays full size on a phone.
direction: down

section: "config section\nrt.ai.language"
env: "env map\n(no config file)"
registry: "registry\ncreateAiRegistry()"
adapter: "the provider's adapter\n(built in, or yours)"
model: "AI SDK LanguageModel"
ask: "ask({ model })"

section -> registry: "*FromSection()"
env -> registry: "*FromEnv()"
registry -> adapter: "by provider name\nor alias"
adapter -> model: "resolveConfig…()\ncreateLanguageModel()"
model -> ask
