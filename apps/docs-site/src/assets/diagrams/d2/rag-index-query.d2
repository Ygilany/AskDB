# @askdb/rag: indexing writes the vector store once per schema change; each ask() with a
# retriever reads it. Indexing embeds only the chunks the store doesn't already hold with the
# same content hash. A question is embedded on every call.
# Source of truth: buildSchemaIndex and createRetriever (default k 8) in packages/rag, and
# synthesizeRetrievedDdl in packages/core/src/retrieval/synthesize-ddl.ts, which lists each
# table a retrieved chunk points to with its full column definitions.
# Vertical, so the text stays full size on a phone.
direction: down

index: "Indexing: once per schema change" {
  direction: down
  artifact: "schema artifact"
  chunks: "chunks"
  artifact -> chunks: "buildSchemaIndex"
}
store: "vector store"
index.chunks -> store: "embedding model:\nnew or changed chunks"

query: "Each ask() call" {
  direction: down
  question: "your question"
  retrieved: "retrieved chunks\n(top k, 8 by default)"
  prompt: "ask()'s prompt:\neach table a chunk\npoints to, in full"
  sql: "checked SQL"
  retrieved -> prompt
  prompt -> sql: "language model"
}
query.question -> store: "embedding model"
store -> query.retrieved: "nearest chunks"
