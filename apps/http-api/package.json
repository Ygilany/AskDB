{
  "name": "@askdb/http-api",
  "version": "1.0.0-beta.44",
  "description": "AskDB HTTP API: minimal HTTP wrapper around @askdb/core. POST /ask returns checked SQL only.",
  "keywords": [
    "askdb",
    "http",
    "api",
    "server",
    "nl-to-sql",
    "natural-language-to-sql",
    "postgres",
    "postgresql",
    "ai",
    "llm",
    "sql"
  ],
  "homepage": "https://askdb.tools/reference/http-api/",
  "bugs": {
    "url": "https://github.com/Ygilany/AskDB/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ygilany/AskDB.git",
    "directory": "apps/http-api"
  },
  "license": "Apache-2.0",
  "author": "Yahya Gilany",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "askdb-http": "./bin/askdb-http.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin.js",
    "dev": "pnpm build && pnpm start",
    "dev:watch": "tsx watch src/bin.ts",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.62",
    "@ai-sdk/azure": "^4.0.78",
    "@ai-sdk/google": "^4.0.79",
    "@ai-sdk/openai": "^4.0.74",
    "@askdb/ai": "workspace:*",
    "@askdb/client": "workspace:*",
    "@askdb/config": "workspace:*",
    "@askdb/core": "workspace:*",
    "@askdb/postgres": "workspace:*",
    "ai": "^7.0.51"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
