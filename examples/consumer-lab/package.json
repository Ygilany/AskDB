{
  "name": "askdb-consumer-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Black-box consumer lab: installs AskDB from packed tarballs or npm like an outside project and runs it against the multi-engine fixture. Not a workspace member.",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "lab": "tsx src/lab-cli.ts",
    "test": "vitest run",
    "matrix": "vitest run --reporter=default --reporter=./src/matrix-reporter.ts",
    "lint": "tsc --noEmit",
    "postgres:up": "docker compose -p askdb-consumer-lab up -d --wait && tsx src/lab-postgres.ts seed",
    "postgres:down": "docker compose -p askdb-consumer-lab down",
    "postgres:reset": "docker compose -p askdb-consumer-lab down && pnpm run postgres:up"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.29",
    "@askdb/ai-openai": "1.0.0-beta.7",
    "@askdb/client": "1.0.0-beta.6",
    "@askdb/config": "1.0.0-beta.12",
    "@askdb/core": "1.0.0-beta.43",
    "@askdb/http-api": "1.0.0-beta.43",
    "@askdb/studio": "0.2.0-beta.36",
    "ai": "7.0.51",
    "askdb": "1.0.0-beta.43",
    "better-sqlite3": "13.0.3",
    "mssql": "12.7.2",
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
