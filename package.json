{
  "name": "askdb-monorepo",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "audit": "audit-ci --config .audit-ci.json",
    "build": "pnpm exec turbo run build",
    "check-updates": "ncu --configFileName .check-updates.json",
    "check-updates:fix": "npm run check-updates -- --upgrade --errorLevel 1",
    "check-updates:all": "npm run check-updates -- --target latest --errorLevel 1",
    "test": "pnpm exec turbo run test",
    "test:watch": "vitest",
    "lint": "node --test scripts/check-test-gating.test.mjs && node scripts/check-test-gating.mjs && pnpm exec turbo run lint",
    "docs:build": "pnpm -C apps/docs-site build",
    "docs:preview": "pnpm -C apps/docs-site preview",
    "docs:dev": "pnpm -C apps/docs-site dev",
    "fixture:up": "pnpm --filter @askdb/fixture-multi-engine run up",
    "fixture:down": "pnpm --filter @askdb/fixture-multi-engine run down",
    "fixture:reset": "pnpm --filter @askdb/fixture-multi-engine run reset",
    "lab": "pnpm -C examples/consumer-lab --silent run lab",
    "lab:use": "node examples/consumer-lab/src/use.mjs",
    "lab:up": "pnpm fixture:up && node examples/consumer-lab/src/use.mjs --if-needed . && pnpm -C examples/consumer-lab --silent run postgres:up",
    "lab:down": "pnpm fixture:down && pnpm -C examples/consumer-lab --silent run postgres:down",
    "lab:reset": "pnpm fixture:reset && node examples/consumer-lab/src/use.mjs --restore && pnpm -C examples/consumer-lab --silent run postgres:reset",
    "lab:safety:isolated": "pnpm -C examples/consumer-lab exec tsx src/isolated-run.ts",
    "lab:record": "pnpm -C examples/consumer-lab --silent run record",
    "lab:test": "pnpm -C examples/consumer-lab test",
    "lab:matrix": "pnpm lab:up && pnpm -C examples/consumer-lab --silent run matrix",
    "pgvector:up": "docker compose -f fixtures/pgvector/docker-compose.yml up -d",
    "pgvector:down": "docker compose -f fixtures/pgvector/docker-compose.yml down",
    "pgvector:logs": "docker compose -f fixtures/pgvector/docker-compose.yml logs -f",
    "pgvector:reset": "docker compose -f fixtures/pgvector/docker-compose.yml down -v",
    "pgvector:test": "ASKDB_PGVECTOR_URL=postgres://postgres:postgres@127.0.0.1:5434/askdb_rag pnpm --filter @askdb/rag --filter @askdb/studio exec vitest run --config ../../vitest.config.ts pgvector.integration",
    "smoke:install": "bash examples/installable-smoke/run.sh",
    "test:ai-floors": "bash scripts/test-ai-sdk-floors.sh",
    "preflight": "bash scripts/release-preflight.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm -r build && pnpm -r publish --access public --tag latest",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@askdb/config": "workspace:*",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.20.5",
    "askdb": "workspace:*",
    "audit-ci": "^7.1.0",
    "npm-check-updates": "^23.1.0",
    "react-doctor": "^0.9.17",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
