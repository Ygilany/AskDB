datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id
  posts    Post[]
  comments Comment[]
}

model Post {
  id       Int   @id
  authorId Int?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model Comment {
  id     Int  @id
  userId Int  @default(0)
  user   User @relation(fields: [userId], references: [id], onDelete: SetDefault, onUpdate: Restrict)
}
