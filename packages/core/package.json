{
  "name": "@askdb/core",
  "version": "1.0.0-beta.55",
  "description": "AskDB core: NL→SQL pipeline with the built-in SQL dialects. Provides ask() orchestration, schema/IR types, modes, logging, and retrieval input. Pass a dialect id such as \"postgres\" and bring your own model.",
  "keywords": [
    "askdb",
    "nl-to-sql",
    "natural-language-to-sql",
    "ai",
    "llm",
    "ai-sdk",
    "schema-v2"
  ],
  "homepage": "https://askdb.tools/reference/core-api/",
  "bugs": {
    "url": "https://github.com/Ygilany/AskDB/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ygilany/AskDB.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Yahya Gilany",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.51"
  },
  "devDependencies": {
    "ai": "^7.0.51",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
